# reference repos — cloned, never committed
references/

# runtime data
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/
data/consolidation/
queue/.processed/
# ...and the failure side of the same directory (added 2026-08-10). A queue
# file is arbitrary user text; leaving .failed/ tracked put it in `git status`,
# where `git add -A` sweeps it into a commit.
queue/.failed/

# python
.venv/
__pycache__/
*.pyc

# node
node_modules/
# NOT ui/dist/ — the dispatcher serves the built SPA straight out of it
# (main.py mounts it at "/"), so a fresh clone needs it committed. It was
# ignored AND tracked, which looks fine right up until you rebuild: git keeps
# tracking existing files regardless of ignore rules, but Vite emits
# content-HASHED asset names, so a rebuilt bundle is a NEW path that the rule
# hides. You would commit an index.html pointing at a file that isn't in the
# repo. Verified 2026-08-02 by dropping a fake index-<hash>.js in and watching
# `git status` stay silent.

# local model files
models/
*.onnx
data/screenshots/

# spotify client-credentials (client id/secret) — never commit
data/spotify.json

# Local secrets (e.g. ANTHROPIC_API_KEY) — never commit
.env
.env.*

# The 2026-08-13 review report is deliberately NOT committed: it details a live,
# unfixed escalation path and this repo is public. Ignored so `git add -A` can't
# sweep it in. Commit it once the repo is private or the finding is fixed.
context/reviews/2026-08-13-full-codebase-review.md

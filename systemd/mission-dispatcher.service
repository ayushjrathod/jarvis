[Unit]
Description=Mission Control dispatcher (FastAPI + task runner, serves the dashboard)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/code/jarvis
# Deliberately NO EnvironmentFile: the quick path runs on the Claude Code
# subscription login, and an ANTHROPIC_API_KEY in this environment would make
# the `claude` CLI abandon that login in favour of the key (removed 2026-07-27).
ExecStart=%h/Documents/code/jarvis/.venv/bin/python -m dispatcher.main
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

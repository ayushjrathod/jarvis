[Unit]
Description=Mission Control — Tailscale Serve (HTTPS front door for the dispatcher over the tailnet)
# Serve just re-asserts config into the tailscaled daemon, so it needs the
# daemon up and the dispatcher listening on loopback first.
After=network-online.target tailscaled.service mission-dispatcher.service
Wants=network-online.target
# Wants, NOT Requires, the dispatcher (2026-09-04): every dispatcher restart
# stops-and-starts serve first, which is benign — but since the 2026-08-10
# StartLimit change `failed` is a state the dispatcher can actually reach,
# and under Requires that deactivated serve while restarting the dispatcher
# did NOT bring it back. Phone access died silently. Under Wants the proxy
# rides out the outage (502s, then recovers with the dispatcher) and no
# intervention is ever needed.
Wants=mission-dispatcher.service

[Service]
Type=oneshot
RemainAfterExit=yes
# `After=tailscaled.service` only orders against the unit STARTING, not against
# the daemon being ready to answer — at boot on 2026-07-26 this unit ran while
# the backend was still in NoState, `tailscale serve` exited 1, and the oneshot
# stayed dead for a day. Same shape as the session-8 boot race where a timer
# fired before the dispatcher had bound its port, and the same fix: wait for
# readiness rather than assume it. Up to 60s, then give up so a genuinely
# broken tailscaled still surfaces as a failure.
ExecStartPre=/usr/bin/bash -c 'for i in $(seq 1 30); do \
  tailscale status --json 2>/dev/null | grep -q "\\"BackendState\\": *\\"Running\\"" && exit 0; \
  sleep 2; done; echo "tailscaled not Running after 60s" >&2; exit 1'
# Publish the loopback dispatcher on the tailnet as HTTPS:443. Prerequisites
# (done by scripts/setup_tailscale.sh): tailscaled up, HTTPS/MagicDNS enabled in
# the admin console, and this user set as a Tailscale operator so `serve` runs
# without sudo. --bg persists the mapping in the daemon; the oneshot then exits.
# That persistence is why phone access kept working even while this unit was
# dead — the mapping lives in tailscaled's own state, not in this service.
ExecStart=/usr/bin/tailscale serve --bg --https=443 http://127.0.0.1:8765
ExecStop=/usr/bin/tailscale serve --https=443 off
# TimeoutStartSec covers ExecStartPre AND ExecStart together, and the readiness
# wait above is allowed to take 60s on its own — leaving only ~30s of the
# inherited DefaultTimeoutStartUSec (1min 30s) for `serve` itself. A slow boot
# would therefore have been killed just short of succeeding, which reads in the
# journal exactly like the tailscaled failure the wait exists to distinguish
# (2026-08-10). 180s = the 60s wait plus real headroom.
TimeoutStartSec=180

[Install]
WantedBy=default.target
